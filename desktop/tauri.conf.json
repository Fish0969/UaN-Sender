{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UaN",
  "version": "1.1.0",
  "identifier": "com.uan.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Peer-to-peer chat and file sharing",
    "longDescription": "Chat, send files of any size and watch films together with friends. Everything runs on your own PC; files go straight from one PC to another.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
